diff --git a/lib/SensorLib/src/SensorQMI8658.hpp b/lib/SensorLib/src/SensorQMI8658.hpp
index ed3d4df..cf19224 100644
--- a/lib/SensorLib/src/SensorQMI8658.hpp
+++ b/lib/SensorLib/src/SensorQMI8658.hpp
@@ -359,6 +359,20 @@ public:
         return comm->readRegister(QMI8658_REG_STATUS_INT);
     }
 
+    bool readFifoInterruptConfig(uint8_t &ctrl1, uint8_t &watermark, uint8_t &fifoCtrl)
+    {
+        int ctrl1Value = comm->readRegister(QMI8658_REG_CTRL1);
+        int watermarkValue = comm->readRegister(QMI8658_REG_FIFO_WTM_TH);
+        int fifoCtrlValue = comm->readRegister(QMI8658_REG_FIFO_CTRL);
+        if (ctrl1Value < 0 || watermarkValue < 0 || fifoCtrlValue < 0) {
+            return false;
+        }
+        ctrl1 = (uint8_t)ctrl1Value;
+        watermark = (uint8_t)watermarkValue;
+        fifoCtrl = (uint8_t)fifoCtrlValue;
+        return true;
+    }
+
