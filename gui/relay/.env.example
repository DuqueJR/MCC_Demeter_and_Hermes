# Copia este archivo a `.env` (ignorado por git) y cambia el token. Una variable de entorno gana al `.env`.

# OBLIGATORIA. Sin ella el relay no arranca. Es la misma que usa el reenviador (estacion/.env o su entorno).
# Un valor largo y aleatorio, por ejemplo:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_INGESTA_TOKEN=cambiame

# Carpeta de los JSONL de cada mision (por defecto gui/relay/datos/, ignorada por git).
# WEB_RELAY_DATOS=

# Origenes que pueden leer el relay desde un navegador (CORS), separados por comas.
# Por defecto: localhost y 127.0.0.1 en los puertos 5173, 4173 y 5174 (vite dev, preview y e2e).
# WEB_RELAY_ORIGENES=https://hermes-demeter.example

# Ruta de esquema.json (por defecto gui/web/src/contrato/esquema.json). La imagen de Docker lo copia a /app/esquema.json y lo fija.
# WEB_RELAY_ESQUEMA=

# Streams SSE abiertos por IP antes de responder 429. Por defecto WEB_SSE_MAX_POR_IP de constantes.py (10).
# Detras de un NAT compartido (el publico del evento) hay que subirlo: en produccion 600 (fly.toml, guia de despliegue §1.2).
# WEB_SSE_MAX_POR_IP=10

# Donde escucha `python servidor.py`. El puerto 8787 es al que apunta el proxy de Vite.
# WEB_RELAY_HOST=127.0.0.1
# WEB_RELAY_PUERTO=8787
