{
  "name": "hermes-demeter-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Web pública de Hermes y Deméter (Universidad EIA, CCCD 2026)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/aislamiento.mjs dist",
    "preview": "vite preview",
    "aislamiento": "node scripts/aislamiento.mjs dist",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "e2e:instalar": "playwright install chromium",
    "lint": "biome check .",
    "formato": "biome check --write ."
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "lucide": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "preact": "^11.0.2",
    "uplot": "^1.6.32",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.0.5"
  }
}
