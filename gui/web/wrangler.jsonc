// Worker de solo assets estáticos que sirve eiaspice.space (T-655).
// Lo publica Cloudflare Workers Builds desde la rama `develop` (root gui/web, `npm run build`, `npx wrangler deploy`).
// VITE_API_BASE NO va aquí ni en ningún archivo del repo: es una variable de build del panel
// (Settings → Build → Variables del Worker).
// Los dominios propios (routes con custom_domain) son críticos: si faltaran, el deploy soltaría eiaspice.space.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-demeter",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "eiaspice.space", "custom_domain": true },
    { "pattern": "web.eiaspice.space", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false
}
