# Copia a .env.local (ignorado por git). Sin secretos: son URLs públicas.
# Base del API de lectura: repetidor (desarrollo), servicio local o relay.
VITE_API_BASE=/api

# PRODUCCION (Worker de assets con Workers Builds, T-642/T-649): NO se pone en un archivo, sino en las variables de build
# del Worker `hermes-demeter` (Settings → Build → Variables):
#   VITE_API_BASE=https://api.eiaspice.space/api
# (el cliente le agrega /v1/<mision>/stream y /snapshot; sin barra final). Ver docs/08_gui/11_guia_despliegue.md.
