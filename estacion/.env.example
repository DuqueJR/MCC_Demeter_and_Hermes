# Copia este archivo a estacion/.env (esta ignorado por git) y llena los valores.
# Sin las dos variables, el reenviador (T-605a) queda apagado y el dashboard se comporta como siempre.
# Las variables de entorno del sistema ganan a este archivo.

# URL del relay publico (T-640). En el evento, con HTTPS. --web-relay en la linea de comandos la reemplaza.
WEB_RELAY_URL=https://relay.ejemplo.org
# Token de ingesta (constantes.md: WEB_INGESTA_TOKEN). Nunca en el repo; se rota despues del evento.
WEB_INGESTA_TOKEN=cambiar-por-el-token-real
